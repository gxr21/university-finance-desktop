APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ufam
DB_USER=ufam
DB_PASS=change-me

# يُستخدم مرة واحدة عند إنشاء حساب الإدارة الأول ثم يُتجاهل.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
